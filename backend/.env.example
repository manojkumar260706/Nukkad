PORT=5001
NODE_ENV=development

# Aiven PostgreSQL
PG_HOST=your-pg-host.aivencloud.com
PG_PORT=11172
PG_USER=avnadmin
PG_PASSWORD=your_password
PG_DATABASE=defaultdb
PG_SSL=true

# Aiven Apache Kafka
# Set false to run with only PostgreSQL. Pickup updates still use PostgreSQL and SSE.
KAFKA_ENABLED=true
KAFKA_BROKERS=your-kafka-host.aivencloud.com:11185
KAFKA_CLIENT_ID=nukkad-app
KAFKA_GROUP_ID=nukkad-consumer-group
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your_password
KAFKA_CA_CERT_PATH=./ca.pem
KAFKA_SSL=true

# Aiven OpenSearch
# Set false to skip OpenSearch typo matching for store-specific search.
OPENSEARCH_ENABLED=true
OPENSEARCH_NODE=https://your-opensearch-host.aivencloud.com:11172
OPENSEARCH_USERNAME=avnadmin
OPENSEARCH_PASSWORD=your_password
OPENSEARCH_INDEX=nukkad_products

ENABLE_FALLBACKS=true

# Razorpay Test Mode credentials from the Razorpay Dashboard
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set a unique strong value for a deployed instance
JWT_SECRET=

# Opt in only for a private demo using the seeded merchant credentials
ENABLE_DEMO_ACCOUNTS=false

# Shopping assistant (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SARVAM_API_KEY=
